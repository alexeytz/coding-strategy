# .env.example - copy to .env and fill in. Never commit .env.
#
# Convention (file 3): every variable is listed here even when optional,
# marked REQUIRED or OPTIONAL, with its default. Precedence is
# env vars > JSON/YAML config > hardcoded defaults.
#
# .env holds what changes per host: URLs, model names, paths, keys.
# Structural config - collections, weights, feature flags - belongs in config/*.json.

# --- Core -------------------------------------------------------------------
# REQUIRED  Deployment environment. One of: development | staging | production
APP_ENV=development

# OPTIONAL  Logging verbosity. One of: debug | info | warning | error
# Default: info
LOG_LEVEL=debug

# OPTIONAL  Absolute path for writable state. Must exist and be writable.
# Default: ./var  - never hardcode a path outside config (37, anti-patterns)
DATA_DIR=./var

# --- External services ------------------------------------------------------
# REQUIRED  Primary datastore connection string.
DATABASE_URL=postgres://user:pass@localhost:5432/dbname

# OPTIONAL  Cache/queue endpoint. Feature degrades gracefully if unset (11.3).
# Default: unset - caching disabled
REDIS_URL=

# --- Credentials ------------------------------------------------------------
# REQUIRED  Placeholder only. Real values never enter this file.
API_KEY=your-api-key-here

# OPTIONAL  Timeout in seconds for outbound calls.
# Default: 30
HTTP_TIMEOUT=30

# --- Delete guard (scripts/safe-delete.sh) ----------------------------------
# OPTIONAL  Where deletes may happen: colon-separated roots, relative to the project root.
# Each root must also contain a .safe-delete-root marker file. safe-delete.sh reads these two
# lines as text (never sources this file); a value set in the environment wins.
# Default: unset - safe-delete.sh refuses every delete until roots are set
SAFE_DELETE_ROOTS=var
# OPTIONAL  The marker file name. Default: .safe-delete-root
SAFE_DELETE_MARKER=.safe-delete-root
# ALLOW_DESTRUCTIVE never goes here: it is the per-call grant that turns a dry run into a move,
# and safe-delete.sh ignores it in any file.
